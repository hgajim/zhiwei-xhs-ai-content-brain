APP_ENV=development
DATABASE_URL=postgresql://brand_kb:change_me@localhost:5432/brand_kb
API_HOST=127.0.0.1
API_PORT=8000

# 兼容 OpenAI Embeddings HTTP 协议的接口
EMBEDDING_BASE_URL=https://你的WorkspaceId.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_PROVIDER=dashscope
DASHSCOPE_BASE_URL=https://你的WorkspaceId.cn-beijing.maas.aliyuncs.com/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_QUERY_INSTRUCTION=Retrieve brand rules, historical review decisions, positive examples, and negative examples relevant to reviewing Xiaohongshu sponsored content.

# 教学理解模型（OpenAI兼容接口）。若 LLM_API_KEY 留空，会复用 EMBEDDING_API_KEY。
LLM_BASE_URL=https://你的WorkspaceId.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=120

# 图片理解与图片向量化（阿里云百炼）
VISION_MODEL=qwen3-vl-flash
VISION_PROMPT_VERSION=xhs-image-understanding-v1
MULTIMODAL_EMBEDDING_MODEL=qwen3-vl-embedding
MULTIMODAL_EMBEDDING_DIMENSIONS=1536
# 运行 `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` 生成
APP_ENCRYPTION_KEY=

# 开发模式可使用确定性伪向量验证数据流程；生产环境必须设为 false
ALLOW_DETERMINISTIC_DEV_EMBEDDING=false

JOB_POLL_SECONDS=2
JOB_MAX_ATTEMPTS=5
ASSET_STORAGE_DIR=data/assets
IMAGE_MAX_BYTES=15728640
IMAGE_MAX_PIXELS=40000000
IMAGE_MAX_COUNT=30
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=30
